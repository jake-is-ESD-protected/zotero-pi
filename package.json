{
  "name": "zotero-pi",
  "version": "0.3.1",
  "description": "Live Zotero library autocomplete, abstract scans, and persistent PDF digests for pi.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jake-is-ESD-protected/zotero-pi.git"
  },
  "homepage": "https://github.com/jake-is-ESD-protected/zotero-pi#readme",
  "bugs": { "url": "https://github.com/jake-is-ESD-protected/zotero-pi/issues" },
  "files": [
    "extensions/zotero/*.ts",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "zotero-pi.example.json"
  ],
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:pi": "node scripts/smoke-pi.mjs",
    "check:package": "node scripts/package.mjs check",
    "test:package": "node scripts/package.mjs test",
    "release:check": "node scripts/release.mjs check",
    "release:tag": "node scripts/release.mjs tag"
  },
  "private": true,
  "keywords": ["pi-package", "zotero", "bibtex", "academic"],
  "type": "module",
  "pi": {
    "extensions": ["./extensions/zotero/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {}
}
